# Copy to .env and fill in only what you need for recover-mint scripts.
# Never pass private keys on the command line (shell history).

# EVM recover-mint
EVM_PRIVATE_KEY=
DEST_CHAIN_ID=

# Solana recover-mint (base58 secret key)
SOLANA_PRIVATE_KEY=

# Aptos recover-mint
APTOS_PRIVATE_KEY=

# Sui recover-mint
SUI_PRIVATE_KEY=
